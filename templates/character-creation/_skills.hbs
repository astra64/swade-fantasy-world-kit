<div class="tab-content">
  <div class="guidance-box">
    <p>{{tabGuidance.skills}}</p>
  </div>

  <div class="skills-container">
    {{#each skillsByAttribute}}
    <div class="skill-attribute-group">
      <h4>{{capitalize @key}}</h4>
      {{#if this.length}}
      <ul class="skills-list">
        {{#each this}}
        <li class="skill-row {{#if this.isCoreSkill}}core-skill{{/if}}">
          <span class="skill-name">
            {{#if this.isCoreSkill}}<span class="core-marker">★</span>{{/if}}
            {{this.name}}
          </span>
          <div class="die-buttons">
            <button type="button" class="die-btn d4 {{#eq this.die 'd4'}}active{{/eq}}" data-action="set-skill" data-skill-uuid="{{this.uuid}}" data-skill-name="{{this.name}}" data-die="d4">d4</button>
            <button type="button" class="die-btn d6 {{#eq this.die 'd6'}}active{{/eq}}" data-action="set-skill" data-skill-uuid="{{this.uuid}}" data-skill-name="{{this.name}}" data-die="d6">d6</button>
            <button type="button" class="die-btn d8 {{#eq this.die 'd8'}}active{{/eq}}" data-action="set-skill" data-skill-uuid="{{this.uuid}}" data-skill-name="{{this.name}}" data-die="d8">d8</button>
            <button type="button" class="die-btn d10 {{#eq this.die 'd10'}}active{{/eq}}" data-action="set-skill" data-skill-uuid="{{this.uuid}}" data-skill-name="{{this.name}}" data-die="d10">d10</button>
            <button type="button" class="die-btn d12 {{#eq this.die 'd12'}}active{{/eq}}" data-action="set-skill" data-skill-uuid="{{this.uuid}}" data-skill-name="{{this.name}}" data-die="d12">d12</button>
          </div>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="empty-text">No skills for this attribute.</p>
      {{/if}}
    </div>
    {{/each}}
  </div>

  <div class="points-info">
    <p><strong>Skill Points:</strong> <span data-skill-points>{{skillPointsUsed}}</span>/12 used</p>
    {{#if (gt skillPointsUsed 12)}}<p class="warning-text">⚠ Over budget ({{subtract skillPointsUsed 12}} over)</p>{{/if}}
  </div>
</div>
