<div class="tab-content">
  <div class="guidance-box">
    <p>{{tabGuidance.gear}}</p>
  </div>

  <div class="gear-container">
    <div class="gear-budget-info">
      <p><strong>Gear Budget:</strong> <span data-gear-cost-used>0</span>/300 silver used</p>
      {{#if (gt gearCostUsed 300)}}<p class="warning-text">⚠ Over budget ({{subtract gearCostUsed 300}} over)</p>{{/if}}
    </div>

    <div class="gear-lists">
      <div class="gear-available">
        <h4>Available Gear</h4>
        <p class="help-text">Drag items from here into your gear list below.</p>
        <div class="gear-list-placeholder">
          <!-- Compendium gear list will be populated here in Phase 3 -->
          <p class="placeholder-text">Gear selection coming in Phase 3</p>
        </div>
      </div>

      <div class="gear-selected">
        <h4>Your Gear</h4>
        {{#if (keys character.gear).length}}
        <div class="selected-gear-list">
          <ul>
            {{#each character.gear}}
            <li class="gear-row">
              <span class="gear-name">{{this.name}}</span>
              {{#if this.cost}}<span class="gear-cost">{{this.cost}} silver</span>{{/if}}
              {{#if this.quantity}}<span class="gear-qty">×{{this.quantity}}</span>{{/if}}
            </li>
            {{/each}}
          </ul>
        </div>
        {{else}}
        <p class="empty-text">No gear selected yet. Drag items from the left to add them.</p>
        {{/if}}
      </div>
    </div>
  </div>
</div>
