<div class="tab-content">
  <div class="guidance-box">
    <p>{{tabGuidance.ancestry}}</p>
  </div>

  <!-- Add Ancestry Section -->
  <div class="form-group">
    <label>Select Ancestry</label>
    <div class="ancestry-input-row">
      <select id="ancestry-select" name="ancestry-select" class="ancestry-dropdown">
        <option value="">-- Choose an ancestry --</option>
        {{#each ancestries}}
        <option value="{{this.uuid}}">{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" class="btn-add-ancestry" data-action="add-ancestry" title="Add selected ancestry">Add</button>
      <button type="button" class="btn-open-compendium" data-action="open-ancestry-compendium" title="Open ancestry compendium browser">Browse Compendium</button>
    </div>
    <p class="hint-text">Search the dropdown, select an ancestry, and click Add. Or use Browse Compendium to drag items directly.</p>
  </div>

  <!-- Selected Ancestry Display -->
  {{#if character.ancestry}}
  <div class="selected-ancestry-section">
    <h4>Selected Ancestry</h4>
    <div class="ancestry-item-container" data-uuid="{{character.ancestry}}" draggable="false">
      {{#if selectedAncestryData}}
      <div class="ancestry-item {{#if expandedAncestry}}expanded{{/if}}" data-action="toggle-ancestry-expand">
        <div class="ancestry-item-header">
          {{#if selectedAncestryData.img}}
          <img src="{{selectedAncestryData.img}}" alt="{{selectedAncestryData.name}}" class="ancestry-item-image">
          {{/if}}
          <div class="ancestry-item-info">
            <span class="ancestry-name">{{selectedAncestryData.name}}</span>
            {{#if selectedAncestryData.type}}
            <span class="ancestry-type">{{selectedAncestryData.type}}</span>
            {{/if}}
          </div>
          <button type="button" class="btn-remove-ancestry" data-action="remove-ancestry" title="Remove ancestry">×</button>
        </div>
        {{#if expandedAncestry}}
        <div class="ancestry-item-description">
          {{#if selectedAncestryData.system.description}}
          {{{selectedAncestryData.system.description}}}
          {{else}}
          <p class="info-text">No description available.</p>
          {{/if}}
        </div>
        {{/if}}
      </div>
      {{/if}}
    </div>

    {{#if selectedAncestryData}}
    <div class="ancestry-bonuses">
      <h4>Applied Ancestry Bonuses</h4>
      <p class="info-text">Ancestry bonuses have been automatically applied to your Attributes and other tabs.</p>
    </div>
    {{/if}}
  </div>
  {{/if}}

  <!-- Drag-Drop Zone -->
  <div class="ancestry-dropzone" data-action="ancestry-dropzone">
    <p class="hint-text">You can also drag an ancestry here from the compendium browser</p>
  </div>
</div>
