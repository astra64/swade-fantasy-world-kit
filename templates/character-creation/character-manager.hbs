<form class="swade-character-manager" id="character-manager">
  <div class="form-tabs">
    <!-- Tab 1: Concept -->
    {{> concept-tab}}

    <!-- Tab 2: Ancestry -->
    {{> ancestry-tab}}

    <!-- Tab 3: Hindrances -->
    {{> hindrances-tab}}

    <!-- Tab 4: Traits (Attributes & Skills) -->
    {{> traits-tab}}

    <!-- Tab 5: Edges -->
    {{> edges-tab}}

    <!-- COMMENTED OUT - Tabs 6-8 will be added incrementally

    Tab 6: Gear
    Tab 7: Summary
    ... (rest of tabs)

    END COMMENTED OUT -->

    <!-- Sticky Footer with Budget Tracker and Action Buttons -->
    <div class="character-manager-footer">
      <div class="budget-tracker">
        <span class="budget-item">
          <span class="budget-label">Attributes:</span>
          <span class="budget-value {{#if (lt attributePointsRemaining 0)}}over-budget{{/if}}">{{attributePointsUsed}}/{{add 5 bonusAttributePoints}}</span>
        </span>
        <span class="budget-item">
          <span class="budget-label">Skills:</span>
          <span class="budget-value {{#if (lt skillPointsRemaining 0)}}over-budget{{/if}}">{{skillPointsUsed}}/{{add 12 bonusSkillPoints}}</span>
        </span>
        <span class="budget-item">
          <span class="budget-label">Edges:</span>
          <span class="budget-value {{#if (gt edgePointsUsed edgePointsAvailable)}}over-budget{{/if}}">{{edgePointsUsed}}/{{edgePointsAvailable}}</span>
        </span>
      </div>

      {{#if (eq @root.currentTab "summary")}}
      <div class="form-actions">
        <button type="button" class="action-button primary" data-action="save">Save Character</button>
        <button type="button" class="action-button secondary" data-action="cancel">Cancel</button>
      </div>
      {{/if}}
    </div>
  </div>
</form>

