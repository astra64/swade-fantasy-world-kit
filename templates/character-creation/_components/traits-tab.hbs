<div class="tab {{#if (eq @root.currentTab 'traits')}}active{{/if}}" data-tab="traits">
  <h3>Attributes & Skills</h3>
  <div class="tab-content">
    <div class="guidance-box">
      <p>{{@root.tabGuidance.traits}}</p>
    </div>

    <div class="swade-traits-container">
      <!-- Agility Attribute -->
      <div class="attribute-section">
        <div class="attribute-header">
          <h3>Agility</h3>
          <div class="attribute-die-buttons">
            {{#each (array "d4" "d6" "d8" "d10" "d12") as |die|}}
              <button
                type="button"
                class="die-btn {{#if (eq @root.character.attributes.agility.die die)}}active{{/if}}"
                data-action="set-attribute"
                data-attribute="agility"
                data-die="{{die}}"
              >
                {{die}}
              </button>
            {{/each}}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
