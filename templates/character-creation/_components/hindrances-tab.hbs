<div class="tab {{#if (eq @root.currentTab 'hindrances')}}active{{/if}}" data-tab="hindrances">
  <h3>Hindrances</h3>

  <div class="tab-content">
    <div class="guidance-box">
      <p>{{@root.tabGuidance.hindrances}}</p>
    </div>

    <!-- Add Hindrance Section -->
    <p class="hint-text">Search the dropdown, select a hindrance, and click Add. Or drag hindrances from the compendium browser.</p>

    {{#if (gt @root.availablePerkPoints 4)}}
    <div class="info-box warning">
      <p><strong>Note:</strong> You've selected {{@root.availablePerkPoints}} perk points, but only 4 can be allocated. Choose which 4 to spend below.</p>
    </div>
    {{/if}}

    <div class="form-group">
      <div class="search-input-row">
        <div class="search-container">
          <input type="text" class="search-input hindrances-search" placeholder="Select Hindrance..." autocomplete="off">
          <div class="dropdown-menu hindrances-dropdown-menu"></div>
        </div>
        <button type="button" class="btn-add-hindrance" data-action="add-hindrance">Add</button>
        <button type="button" class="btn-open-compendium" data-action="open-hindrances-compendium">Browse</button>
      </div>
    </div>

    <!-- Selected Hindrances Display -->
    {{#each @root.character.hindrances}}
    {{#if @first}}
    <div class="selected-hindrances-section">
      <h4>Selected Hindrances</h4>
    {{/if}}
      <div class="hindrance-item {{#if this.expanded}}expanded{{/if}}">
        <!-- Header (Always Visible) -->
        <div class="hindrance-item-header">
          <!-- Left side: clickable to expand -->
          <div class="hindrance-expand-trigger" data-action="toggle-hindrance-expand" data-item-uuid="{{this.uuid}}">
            <div class="hindrance-item-image-wrapper">
              {{#if this.img}}
              <img src="{{this.img}}" alt="{{this.name}}" class="hindrance-item-image">
              {{/if}}
            </div>
            <div class="hindrance-item-info">
              <span class="hindrance-name">{{this.name}}</span>
            </div>
          </div>

          <!-- Right side: interactive controls (don't trigger expand) -->
          <div class="hindrance-controls">
            <div class="hindrance-major-minor">
              <label class="radio-label">
                <input type="radio" name="hindrance-{{this.uuid}}-type" value="major" {{#if this.major}}checked{{/if}} {{#if (eq this.severity "minor")}}disabled{{/if}} data-action="set-hindrance-major" data-item-uuid="{{this.uuid}}" class="hindrance-major-toggle">
                <span>Major</span>
              </label>
              <label class="radio-label">
                <input type="radio" name="hindrance-{{this.uuid}}-type" value="minor" {{#unless this.major}}checked{{/unless}} {{#if (eq this.severity "major")}}disabled{{/if}} data-action="set-hindrance-minor" data-item-uuid="{{this.uuid}}" class="hindrance-minor-toggle">
                <span>Minor</span>
              </label>
            </div>
            <button type="button" class="btn-open-hindrance" data-action="open-hindrance-item" data-uuid="{{this.uuid}}" title="Open item"></button>
            <button type="button" class="btn-remove-hindrance" data-action="remove-hindrance" title="Remove hindrance">×</button>
          </div>
        </div>

        <!-- Description (Expandable) -->
        {{#if this.expanded}}
        <div class="hindrance-item-description">
          {{#if this.description}}
          {{{this.description}}}
          {{else}}
          <p class="info-text">No description available.</p>
          {{/if}}
        </div>
        {{/if}}
      </div>
    {{#if @last}}
    </div>
    {{/if}}
    {{else}}
    <p class="info-text">No hindrances selected yet. You can add up to 4 points' worth of hindrances to gain bonus points.</p>
    {{/each}}

    <!-- Hindrances Tab Footer: Perk Point Allocation -->
    {{#if @root.character.hindrances}}
    <div class="hindrances-tab-footer">
      <h4>Allocate Perks — {{@root.perkPointsSpent}}/{{@root.availablePerkPoints}}</h4>
      <div class="hindrances-tradeoff-slots">
        {{#each @root.perkSlots}}
          {{#if (isPerkSlotVisible ../perkSlots @index)}}
          <div class="tradeoff-slot" data-tradeoff-slot="{{@index}}">
            <select class="tradeoff-dropdown" data-slot-index="{{@index}}" data-action="set-slot-tradeoff">
              <option value="">-- Select Perk --</option>

              {{#if (gte this.pointValue 2)}}
                <option value="attribute-boost" {{#if (eq this.selected "attribute-boost")}}selected{{/if}}>
                  Raise Attribute (2)
                </option>
                <option value="edge" {{#if (eq this.selected "edge")}}selected{{/if}}>
                  Choose an Edge (2)
                </option>
              {{else}}
                <option value="attribute-boost" disabled>Raise Attribute (2)</option>
                <option value="edge" disabled>Choose an Edge (2)</option>
              {{/if}}

              <option value="skill-point" {{#if (eq this.selected "skill-point")}}selected{{/if}}>
                Gain Skill Point (1)
              </option>
              <option value="extra-funds" {{#if (eq this.selected "extra-funds")}}selected{{/if}}>
                Extra {{@root.currencyAmount}} {{@root.currencyName}} (1)
              </option>
            </select>
          </div>
          {{/if}}
        {{/each}}
      </div>
    </div>
    {{/if}}
  </div>
</div>
