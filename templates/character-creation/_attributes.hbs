<div class="tab-content">
  <div class="guidance-box">
    <p>{{tabGuidance.attributes}}</p>
  </div>

  {{#if character.ancestry}}
  <div class="ancestry-notice">
    <p class="info-text">✓ Ancestry bonuses have been applied. Minimum attribute values are locked.</p>
  </div>
  {{/if}}

  <div class="attributes-grid">
    {{#each (keys character.attributes)}}
    <div class="attribute-section">
      <h4>{{capitalize this}}</h4>
      <div class="die-buttons">
        <button type="button" class="die-btn d4 {{#eq character.attributes.[this].die 'd4'}}active{{/eq}}" data-action="set-attribute" data-attribute="{{this}}" data-die="d4">d4</button>
        <button type="button" class="die-btn d6 {{#eq character.attributes.[this].die 'd6'}}active{{/eq}}" data-action="set-attribute" data-attribute="{{this}}" data-die="d6">d6</button>
        <button type="button" class="die-btn d8 {{#eq character.attributes.[this].die 'd8'}}active{{/eq}}" data-action="set-attribute" data-attribute="{{this}}" data-die="d8">d8</button>
        <button type="button" class="die-btn d10 {{#eq character.attributes.[this].die 'd10'}}active{{/eq}}" data-action="set-attribute" data-attribute="{{this}}" data-die="d10">d10</button>
        <button type="button" class="die-btn d12 {{#eq character.attributes.[this].die 'd12'}}active{{/eq}}" data-action="set-attribute" data-attribute="{{this}}" data-die="d12">d12</button>
      </div>
    </div>
    {{/each}}
  </div>

  <div class="points-info">
    <p><strong>Attribute Points:</strong> <span data-attribute-points>{{attributePointsUsed}}</span>/5 used</p>
    {{#if (gt attributePointsUsed 5)}<p class="warning-text">⚠ Over budget ({{subtract attributePointsUsed 5}} over)</p>{{/if}}
  </div>
</div>
